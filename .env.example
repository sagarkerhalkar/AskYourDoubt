# Replace this before any public deployment.
AYD_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Local Compose URL. Change to the exact HTTPS public domain in production.
AYD_BASE_URL=http://127.0.0.1:9000

# Host port for docker-compose.yml.
AYD_PORT=9000

# Used by docker-compose.production.yml and deploy/Caddyfile.
AYD_DOMAIN=ask.sagarkerhalkar.com
